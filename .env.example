# Lipi.ai V1 — copy to .env and fill what you have.
# Local simulator works with no keys.

PORT=3000
# Browser demo can stay on localhost. For Vapi phone webhooks, run `npm run tunnel`
# then paste the ngrok https URL here (no trailing slash).
PUBLIC_BASE_URL=http://localhost:3000
NGROK_AUTHTOKEN=

# Founder / company
FOUNDER_NAME=Sachin
COMPANY_NAME=Lipi.ai

# Meeting slots shown by the bot (or leave blank to auto-pick next weekdays)
MEETING_SLOT_1=
MEETING_SLOT_2=
MEETING_SLOT_3=
CAL_BOOKING_URL=https://calendly.com/your-handle/30min
CAL_API_KEY=
CAL_EVENT_TYPE_ID=

# Real phone calls via Vapi (optional — browser demo works without this)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_WEBHOOK_SECRET=

# TTS routing (Doc 9 — mix vendors by language, do not pick one for everything)
TTS_EN_US_PROVIDER=elevenlabs
TTS_EN_US_VOICE_ID=
TTS_EN_IN_PROVIDER=sarvam
TTS_EN_IN_VOICE_ID=
TTS_HINGLISH_PROVIDER=sarvam
TTS_HINGLISH_VOICE_ID=

# Sarvam AI Bulbul — native Hinglish / Indian-English voices for the browser demo.
# Free tier at sarvam.ai. Leave blank and the free Edge voices are used instead.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
# Male voices by default: the Hinglish script is written in masculine Hindi.
SARVAM_SPEAKER_HINGLISH=shubh
SARVAM_SPEAKER_EN_IN=shubh
SARVAM_LANG_HINGLISH=hi-IN

# Edge (free, keyless) voice overrides — `npm run voices` lists all 322.
TTS_EDGE_VOICE_EN_US=
TTS_EDGE_VOICE_EN_IN=
TTS_EDGE_VOICE_HINGLISH=

# Post-call dispo scoring (Claude Haiku in the PDF). Optional — heuristic fallback is built in.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Free LLM for natural spoken replies (Groq). Local scripted fallback if empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# The call script — every line the agent can say, plus the FAQ it answers from.
SCRIPT_PATH=scripts/call-script.yaml

# Storage
LEADS_PATH=data/leads.csv
DNC_PATH=data/dnc.csv
CALLS_PATH=data/calls.json

